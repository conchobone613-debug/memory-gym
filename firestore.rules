rules_version = '2';

/*
 * 로그인 없이, 알 수 없는 동기화 코드 하나로만 접근한다.
 *
 * 왜 이렇게 했나: Firebase Auth 를 켜려면 결제 등록이나 콘솔 작업이 필요한데,
 * 이 앱이 옮기는 것은 이미지 이름과 반응시간뿐이라 거기까지 갈 이유가 없었다.
 *
 * 안전 장치는 두 가지다.
 *  1. 코드는 128비트 난수다. 찍어서 맞힐 수 없다.
 *  2. list 를 막는다. 코드를 모르면 문서가 있는지조차 알 수 없다.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /sync/{code} {
      allow get, create, update: if code.size() >= 24;
      allow list, delete: if false;

      match /{sub=**} {
        allow get, create, update: if code.size() >= 24;
        allow list: if code.size() >= 24;   // 내려받을 때 batches 를 훑어야 한다
        allow delete: if false;
      }
    }
  }
}
